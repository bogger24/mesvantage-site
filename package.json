{
  "name": "mesvantage-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-claims.mjs dist && node scripts/check-html.mjs dist && node scripts/check-company.mjs",
    "preview": "astro preview",
    "check": "node scripts/check-claims.mjs dist",
    "typecheck": "astro check --minimumSeverity error",
    "pdf": "npm run build && node scripts/build-pdf.mjs",
    "test:claims": "node scripts/check-claims.test.mjs",
    "a11y": "node scripts/check-a11y.mjs dist",
    "og": "node scripts/build-og-image.mjs"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^4.16.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.12.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
