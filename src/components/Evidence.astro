---
/**
 * Renders a statistic from the claims register, and nothing else.
 *
 * The `data-evidence` attribute is what scripts/check-claims.mjs looks for. A number rendered
 * outside one of these fails the build — that is the whole mechanism.
 *
 * Figures are set in the mono face with tabular figures. That is not decoration: on this site
 * a number is a record, and it should not be set in the same bold sans as the headline it sits
 * under, where it reads as an adjective. It also makes a column of them align, which is most
 * of the point of publishing them together.
 *
 * Three variants:
 *   stat    — a figure in a readout row, label beneath
 *   inline  — a figure inside a sentence
 *   compact — a figure with its label to the right, for tight columns
 */
import { claims, type ClaimId } from '../data/claims';

interface Props {
  claim: ClaimId;
  variant?: 'stat' | 'inline' | 'compact';
  /** Override the label, e.g. to shorten it in a tight column. Never overrides the value. */
  label?: string;
  /** Render for a dark surface. */
  onDark?: boolean;
}

const { claim: claimId, variant = 'stat', label, onDark = false } = Astro.props;
const claim = claims[claimId];

if (claim.status === 'retired') {
  throw new Error(
    `Claim "${claimId}" is retired and must not be rendered. Reason: ${claim.retiredReason}`,
  );
}

const displayLabel = label ?? claim.label;

// A claim whose evidence artefact does not exist yet must not render identically to one that
// has been checked. The register drew the distinction; the component was throwing it away.
//
// It used to be an amber block. On a band of five figures with three of them pending, the
// loudest thing in the section became our own uncertainty, rendered as a warning. The
// distinction still has to be visible and still has to link to /evidence — but it is a
// footnote to the number, not a hazard label, so it is set as a dagger and a quiet line.
const pending = claim.status === 'needs-evidence';

const valueColour = onDark ? 'text-white' : 'text-navy';
const labelColour = onDark ? 'text-muted-onDark' : 'text-muted';
const markColour = onDark
  ? 'text-accent-onDark hover:text-white'
  : 'text-accent hover:text-accent-dark';
---

{
  variant === 'stat' && (
    <div data-evidence={claim.id} data-token={claim.token}>
      <div class={`figure text-figure-md md:text-figure-lg whitespace-nowrap ${valueColour}`}>{claim.value}</div>
      <div class={`eyebrow mt-3 ${onDark ? 'text-white/70' : 'text-ink/75'}`}>{displayLabel}</div>
      {claim.context && (
        <div class={`mt-1.5 text-xs leading-snug ${labelColour}`}>{claim.context}</div>
      )}
      {pending && (
        <a
          href="/evidence"
          class={`mt-2 inline-flex items-center min-h-[24px] font-mono text-[10px] font-semibold uppercase tracking-eyebrow ${markColour}`}
        >
          <span aria-hidden="true" class="mr-1">
            †
          </span>{' '}
          Evidence pending
        </a>
      )}
    </div>
  )
}

{
  variant === 'compact' && (
    <div data-evidence={claim.id} data-token={claim.token} class="flex items-baseline gap-3">
      <span class={`figure text-lg font-semibold ${valueColour}`}>{claim.value}</span>
      <span class={`text-sm ${labelColour}`}>
        {displayLabel}
        {pending && (
          <a
            href="/evidence"
            title="Evidence for this figure has not been produced yet"
            class={`ml-1 font-mono text-[10px] font-bold no-underline ${markColour}`}
          >
            †
          </a>
        )}
      </span>
    </div>
  )
}

{
  variant === 'inline' && (
    <span data-evidence={claim.id} data-token={claim.token} class="figure font-semibold">
      {claim.value}
      {pending && (
        <a
          href="/evidence"
          title="Evidence for this figure has not been produced yet"
          class={`ml-0.5 align-super text-[0.6em] font-bold no-underline hover:underline ${markColour}`}
        >
          †
        </a>
      )}
    </span>
  )
}
