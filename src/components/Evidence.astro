---
/**
 * Renders a statistic from the claims register, and nothing else.
 *
 * The `data-evidence` attribute is what scripts/check-claims.mjs looks for. A number rendered
 * outside one of these fails the build — that is the whole mechanism.
 *
 * Two variants:
 *   stat   — the large figure used in a facts band
 *   inline — a figure inside a sentence
 */
import { claims, type ClaimId } from '../data/claims';

interface Props {
  claim: ClaimId;
  variant?: 'stat' | 'inline';
  /** Override the label, e.g. to shorten it in a tight column. Never overrides the value. */
  label?: string;
}

const { claim: claimId, variant = 'stat', label } = Astro.props;
const claim = claims[claimId];

if (claim.status === 'retired') {
  throw new Error(
    `Claim "${claimId}" is retired and must not be rendered. Reason: ${claim.retiredReason}`,
  );
}

const displayLabel = label ?? claim.label;

// A claim whose evidence artefact does not exist yet must not render identically to one that
// has been checked. The register drew the distinction; the component was throwing it away.
const pending = claim.status === 'needs-evidence';
---

{
  variant === 'stat' ? (
    <div data-evidence={claim.id} data-token={claim.token}>
      <div class="text-2xl md:text-3xl font-extrabold text-navy tabular-nums">{claim.value}</div>
      <div class="text-xs uppercase tracking-wider text-ink/70 mt-1 font-semibold">
        {displayLabel}
      </div>
      {claim.context && <div class="text-xs text-ink/60 mt-1">{claim.context}</div>}
      {pending && (
        <a
          href="/evidence"
          class="mt-2 inline-block text-[10px] font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 border border-amber-300 px-1.5 py-0.5 rounded hover:bg-amber-200 transition-colors"
        >
          Evidence pending
        </a>
      )}
    </div>
  ) : (
    <span data-evidence={claim.id} data-token={claim.token} class="font-semibold tabular-nums">
      {claim.value}
    </span>
  )
}
