---
const links = [
  { label: 'Product', href: '/product' },
  { label: 'Compliance', href: '/compliance' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
];
---

<footer class="bg-navy text-white/70 mt-24">
  <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col md:flex-row justify-between gap-8">
    <div>
      <p class="text-white font-bold text-lg tracking-tight">MESvantage</p>
      <p class="text-sm mt-1">The manufacturing intelligence platform for regulated industry.</p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-6">
      {links.map(link => (
        <a href={link.href} class="text-sm hover:text-white transition-colors">{link.label}</a>
      ))}
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-4 text-xs text-white/40">
      © {new Date().getFullYear()} MESvantage Limited. All rights reserved.
    </div>
  </div>
</footer>
