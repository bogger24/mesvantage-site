---
const navLinks = [
  { label: 'Product', href: '/product' },
  { label: 'Compliance', href: '/compliance' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
];
---

<header class="bg-white border-b border-border sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="text-navy font-bold text-xl tracking-tight">MESvantage</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="text-sm font-medium text-ink/70 hover:text-navy transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/about#contact"
        class="bg-accent hover:bg-accent-dark text-white text-sm font-semibold px-4 py-2 rounded-md transition-colors"
      >
        Book a Demo
      </a>

      <!-- Mobile menu toggle (visible on small screens only) -->
      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-surface transition-colors" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav class="absolute right-0 top-full mt-1 w-48 bg-white border border-border rounded-xl shadow-lg py-2 z-50">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="block px-4 py-2 text-sm font-medium text-ink/70 hover:text-navy hover:bg-surface transition-colors"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
