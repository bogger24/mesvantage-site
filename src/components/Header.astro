---
/**
 * "What we don't do" sits in the primary navigation on purpose.
 *
 * It is the page most likely to win a technical evaluation and the one a competitor cannot
 * copy without actually being honest, so burying it in the footer wastes it. A buyer who
 * finds it in the nav rather than in due diligence reads it as confidence; the same page
 * found later reads as something we hoped they would miss.
 */
const navLinks = [
  { label: 'Product', href: '/product' },
  { label: 'Compliance', href: '/compliance' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Evidence', href: '/evidence' },
  { label: "What we don't do", href: '/limits' },
  { label: 'About', href: '/about' },
];
---

<header class="site-header sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="text-white font-bold text-xl tracking-tight">MESvantage</span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="inline-flex items-center min-h-[24px] font-mono text-[11px] font-semibold uppercase tracking-eyebrow text-muted-onDark hover:text-white transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/mesvantage-product-overview.pdf"
         class="hidden sm:inline-flex items-center bg-accent hover:bg-accent-dark text-white font-mono text-[11px] font-semibold uppercase tracking-eyebrow px-4 py-2.5 rounded-md transition-colors">
        Download overview
      </a>

      <!-- Mobile menu toggle (visible on small screens only) -->
      <details class="lg:hidden relative">
        <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-white/10 transition-colors" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 top-full mt-1 w-56 bg-navy-lift border border-rule-onDark rounded-lg shadow-2xl py-2 z-50">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="block px-4 py-2.5 font-mono text-[11px] font-semibold uppercase tracking-eyebrow text-muted-onDark hover:text-white hover:bg-white/5 transition-colors"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script src="/nav.js" defer is:inline></script>
