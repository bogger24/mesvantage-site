---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'MESvantage — the manufacturing execution and intelligence system for orthopaedic implant manufacturers.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;

// Absolute, because LinkedIn, Slack and Outlook all reject a relative og:image and fall back
// to a bare text card. Generated by scripts/build-og-image.mjs.
const ogImage = new URL('/og.png', Astro.site).href;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MESvantage',
  legalName: 'MESvantage Limited',
  url: 'https://mesvantage.com',
  description:
    'Manufacturing execution and intelligence system for medical device contract manufacturers machining orthopaedic implants.',
  address: { '@type': 'PostalAddress', addressCountry: 'IE' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'hello@mesvantage.com',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta property="og:title" content={`${title} | MESvantage`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MESvantage" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="MESvantage — every implant, every operation, every signature, one validated record."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | MESvantage`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#061426" />
    <title>{title} | MESvantage</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {/* Head, not deferred: the js flag must land on <html> before first paint or every
        .reveal element flashes. See public/motion.js. */}
    <script src="/motion.js" is:inline></script>
    <script defer data-domain="mesvantage.com" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-md"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
