---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishableClaims, retiredClaims } from '../data/claims';

const live = publishableClaims();
const retired = retiredClaims();

const verified = live.filter((c) => c.status === 'verified');
const pending = live.filter((c) => c.status === 'needs-evidence');

const tokenCopy: Record<string, string> = {
  MEASURED: 'Measured at our founding customer',
  VALIDATED: 'From the validation record',
  SOURCED: 'External or third-party source',
  'OUR-RESEARCH': 'Our own research — not third-party',
  MODELLED: 'Our own figure or estimate',
  ROADMAP: 'Not yet available',
};
---

<BaseLayout
  title="Evidence"
  description="Every number published on mesvantage.com, with its source, method, and the date it was last verified — including the claims we have retired and why."
>
  <section class="bg-navy text-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow text-accent-onDark tick-on-dark">Evidence</span>
      <h1 class="mt-2 text-3xl md:text-5xl font-extrabold leading-tight">
        Every number on this site, and where it comes from.
      </h1>
      <p class="mt-6 text-white/70 text-lg leading-relaxed max-w-2xl">
        We publish this because we got it wrong. An earlier version of this site carried a band of
        outcome claims that were never measured, one of which — a validation budget of zero — was
        simply false. Every one of them is listed below, retired, with the reasoning intact.
      </p>
      <p class="mt-4 text-white/70 leading-relaxed max-w-2xl">
        A number now reaches a page only through this register, and the build fails if one does
        not. That is a mechanism rather than a promise, which is the only kind worth making.
      </p>
    </div>
  </section>

  <section class="py-16 px-6 bg-navy-lift">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-white">Verified</h2>
      <p class="mt-2 text-muted-onDark">The evidence artefact exists and has been checked.</p>

      <div class="mt-8 space-y-6">
        {verified.map((c) => (
          <article data-evidence={c.id} data-token={c.token} class="border border-rule-onDark rounded-md p-6 bg-navy-lift">
            <div class="flex flex-wrap items-baseline gap-3">
              <span class="text-2xl font-extrabold text-white tabular-nums">{c.value}</span>
              <span class="text-sm font-semibold text-white/80">{c.label}</span>
              <span class="ml-auto text-[10px] font-bold tracking-wider uppercase bg-accent/10 text-accent-onDark px-2 py-1 rounded">
                {tokenCopy[c.token]}
              </span>
            </div>
            <p class="mt-3 text-white/80 leading-relaxed">{c.statement}</p>
            <dl class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
              <div><dt class="text-muted-onDark inline">Source: </dt><dd class="inline text-white/80">{c.source}</dd></div>
              {c.method && <div><dt class="text-muted-onDark inline">Method: </dt><dd class="inline text-white/80">{c.method}</dd></div>}
              {c.verifiedOn && (
                <div><dt class="text-muted-onDark inline">Verified: </dt><dd class="inline text-white/80">{c.verifiedOn} by {c.verifiedBy}</dd></div>
              )}
            </dl>
            {c.caveat && (
              <p class="mt-3 text-sm text-muted-onDark border-l-2 border-rule-onDark pl-3">{c.caveat}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-6 bg-navy-lift border-y border-rule-onDark">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-white">Evidence still to be produced</h2>
      <p class="mt-2 text-muted-onDark max-w-2xl">
        We believe each of these is true and we have hedged the wording accordingly, but the
        artefact that would let you check it does not exist yet. Listing them here is the point.
      </p>

      <div class="mt-8 space-y-6">
        {pending.map((c) => (
          <article data-evidence={c.id} data-token={c.token} class="border border-amber-300/50 bg-amber-400/10 rounded-md p-6">
            <div class="flex flex-wrap items-baseline gap-3">
              <span class="text-2xl font-extrabold text-white tabular-nums">{c.value}</span>
              <span class="text-sm font-semibold text-white/80">{c.label}</span>
              <span class="ml-auto text-[10px] font-bold tracking-wider uppercase bg-amber-300/20 text-amber-200 px-2 py-1 rounded">
                Evidence pending
              </span>
            </div>
            <p class="mt-3 text-white/80 leading-relaxed">{c.statement}</p>
            <p class="mt-3 text-sm"><span class="text-muted-onDark">Source: </span><span class="text-white/80">{c.source}</span></p>
            {c.caveat && <p class="mt-2 text-sm text-muted-onDark border-l-2 border-amber-300 pl-3">{c.caveat}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-6 bg-navy-lift">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-white">Retired claims</h2>
      <p class="mt-2 text-muted-onDark max-w-2xl">
        Published previously, removed, and kept here so the reasoning outlives the cleanup.
      </p>

      <div class="mt-8 space-y-6">
        {retired.map((c) => (
          <article data-retired data-evidence={c.id} data-token={c.token} class="border border-rule-onDark rounded-md p-6">
            <div class="flex flex-wrap items-baseline gap-3">
              <span class="text-xl font-bold text-muted-onDark line-through tabular-nums">{c.value}</span>
              <span class="text-sm font-semibold text-muted-onDark line-through">{c.label}</span>
              <span class="ml-auto text-[10px] font-bold tracking-wider uppercase bg-white/10 text-muted-onDark px-2 py-1 rounded">
                Retired
              </span>
            </div>
            <p class="mt-3 text-white/80 leading-relaxed">{c.retiredReason}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy text-white py-16 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold">Found something here you can disprove?</h2>
      <p class="mt-4 text-white/70">
        Tell us and we will correct it on this page, with the date. That offer is the reason the
        page exists.
      </p>
      <a
        href="/about#contact"
        class="inline-block mt-8 bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-md transition-colors"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
