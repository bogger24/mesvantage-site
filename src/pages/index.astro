---
import BaseLayout from '../layouts/BaseLayout.astro';
import Evidence from '../components/Evidence.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import SpecHeader from '../components/SpecHeader.astro';
import { claims } from '../data/claims';
---

<BaseLayout
  title="MES for orthopaedic implant manufacturers"
  description="The manufacturing execution system for orthopaedic implant manufacturers — built inside a live knee-implant plant and validated there in production."
>

  {/*
    Hero.

    Left-aligned, on the near-black navy rather than the mid brand navy. Centred multi-line
    body copy over a full-bleed coloured panel is the single strongest "landing page template"
    signal there is, and this page had it three times over.

    The Record Strip beneath is the signature device: the fields a device history record
    actually carries, set in mono between two hairlines. It states what the product is faster
    than the paragraph above it does.
  */}
  <section class="bg-navy-deep text-white pt-20 px-6 relative overflow-x-clip">
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none grid-overlay grid-overlay-fade"></div>
    <div class="max-w-6xl mx-auto relative">
      <p class="eyebrow text-accent-onDark tick-on-dark">Orthopaedic implant manufacturing</p>

      <h1 class="mt-1 text-display-md md:text-display-xl max-w-5xl text-balance">
        Every implant. Every operation. Every signature. One record.
      </h1>

      <div class="mt-8 grid md:grid-cols-12 gap-x-10 gap-y-8 items-center">
        <p class="md:col-span-7 text-lg md:text-xl text-white/70 leading-relaxed">
          MESvantage is the manufacturing execution and intelligence system built inside a live
          <Evidence claim="plant-volume" variant="inline" />-knee-a-year orthopaedic plant in
          Ireland — and validated there, in production, under that site's ISO 13485 quality
          system. Audit preparation stops being an archaeology project.
        </p>
        <div class="md:col-span-4 md:col-start-9 flex flex-col gap-3">
          <a
            href="/mesvantage-product-overview.pdf"
            class="bg-accent hover:bg-accent-dark text-white font-semibold px-7 py-3.5 rounded-md transition-colors text-center"
          >
            Download the product overview
          </a>
          <a
            href="/about#contact"
            class="border border-white/25 hover:border-white/70 hover:bg-white/5 text-white font-semibold px-7 py-3.5 rounded-md transition-colors text-center"
          >
            Talk to the founder
          </a>
        </div>
      </div>

      {/*
        The Record Strip: the fields a device history record actually carries, mono between two
        hairlines — and directly beneath it, the application itself. The strip says what the
        system writes; the frame shows the system writing it.
      */}
      <ul class="record-strip mt-14 mb-0 list-none">
        <li>Serial</li>
        <li aria-hidden="true" class="text-white/20">—</li>
        <li>Operation</li>
        <li aria-hidden="true" class="text-white/20">—</li>
        <li>Gauge</li>
        <li aria-hidden="true" class="text-white/20">—</li>
        <li>Result</li>
        <li aria-hidden="true" class="text-white/20">—</li>
        <li>Signed</li>
        <li aria-hidden="true" class="text-white/20">—</li>
        <li>Hash</li>
        <li aria-hidden="true" class="text-white/20">—</li>
        <li>UTC</li>
      </ul>
      <p class="text-sm text-muted-onDark pt-4 pb-10">
        What the system writes for every operation, on every part. People sign; the system
        proves.
      </p>

      {/*
        The product, in the hero, in a window frame whose title bar carries the real route and
        build from the capture manifest. It bleeds into the section below — the page opens with
        the argument and lands on the evidence.
      */}
      <div class="glow-panel relative z-10 -mb-20 md:-mb-36">
        <ProductScreenshot
          image="inspections-desktop.png"
          caption="Inspection queue — incoming, in-process and final, against the plan"
          tone="dark"
          priority={true}
        />
      </div>
    </div>
  </section>

  {/*
    Pain recognition.

    Was three pale rounded cards with pastel icon chips — the default SaaS card, which appeared
    three separate times on this page. The icons carried no information: a generic document
    glyph next to "audit prep is a three-week fire drill" tells the reader nothing they did not
    get from the sentence.

    A ruled list with mono indices does the same job with less ink and reads as a findings
    list, which is what it is.
  */}
  <section class="pt-40 md:pt-64 pb-20 px-6 bg-white border-b border-rule">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="01" label="Does this sound familiar?" meta="Findings, floor-level" />
      <h2 class="text-display-sm md:text-display-md text-navy max-w-2xl text-balance">
        The problems every CDMO lives with.
      </h2>

      <ul class="mt-12 list-none">
        {[
          {
            title: 'Audit prep is a three-week fire drill',
            body: 'Every FDA or notified body visit means weeks of pulling records, chasing paper travellers, and reconstructing device history from spreadsheets and shared drives.',
          },
          {
            title: "You can't see your floor in real time",
            body: 'Machine status, OEE, active jobs, operator positions — none of it is visible until someone walks the floor or checks a whiteboard at shift handover.',
          },
          {
            title: 'Your quality system is a shared drive',
            body: 'FAIs, NCs, CAPAs, incoming inspection results — scattered across SharePoint folders, email threads, and institutional knowledge that leaves when people leave.',
          },
        ].map((row, i) => (
          <li class="ruled last:border-b last:border-rule">
            <div class="grid md:grid-cols-12 gap-x-8 gap-y-2 py-7">
              <span class="index-num md:col-span-1 pt-1">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="md:col-span-4 text-lg font-bold text-navy leading-snug">{row.title}</h3>
              <p class="md:col-span-7 text-ink/75 leading-relaxed">{row.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    Facts band. Replaced the previous outcomes band (90d / ~70% / ~75% / €0) on 2026-07-27.
    Those four were unsourced outcome claims and one of them — "€0 Validation Budget" — was
    false: under ISO 13485 §4.1.6 and the FDA QMSR, validating software for intended use is the
    device manufacturer's obligation and no supplier can discharge it.
    Rule from here: counts, not percentages. A hostile reader can argue with a percentage; they
    cannot argue with a count. No percentage returns to this page until it has been measured,
    with a stated method, signed off by the person who measured it.
  */}
  {/*
    The readout. Set like an instrument panel: mono tabular figures, hairline-separated
    columns, on the near-black navy so the numbers are the brightest thing in the section.

    The previous version put three amber "EVIDENCE PENDING" blocks in a row of five figures,
    which made our own uncertainty the loudest element on the page — honest, but shouting.
    The dagger and the quiet line say the same thing and still link to /evidence.
  */}
  <section class="bg-navy-deep text-white">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="grid grid-cols-2 md:grid-cols-5 divide-y divide-rule-onDeep md:divide-y-0 md:divide-x md:divide-rule-onDeep">
        <div class="pb-8 md:pb-0 md:pr-6"><Evidence claim="plant-volume" onDark /></div>
        <div class="pb-8 md:pb-0 md:px-6"><Evidence claim="module-count" onDark /></div>
        <div class="pt-8 md:pt-0 md:px-6"><Evidence claim="validation-tests" onDark /></div>
        <div class="pt-8 md:pt-0 md:px-6"><Evidence claim="validation-rtm" onDark /></div>
        <div class="pt-8 md:pt-0 md:pl-6 col-span-2 md:col-span-1">
          <Evidence claim="ortho-vendor-count" onDark />
        </div>
      </div>

      <div class="mt-14 pt-8 border-t border-rule-onDeep grid md:grid-cols-12 gap-x-8 gap-y-4">
        <p class="eyebrow text-muted-onDark md:col-span-3">On that last one</p>
        <p data-evidence="ortho-vendor-count" class="md:col-span-9 text-muted-onDark leading-relaxed">
          We looked across eighteen platforms and roughly three hundred sources in July 2026 and
          could not find another MES vendor with a named orthopaedic implant machining customer.
          <span class="text-white font-semibold">
            If you can name one, tell us and we will publish it here.
          </span>
          <a
            href="/evidence"
            class="block mt-4 font-semibold text-accent-onDark hover:text-white transition-colors"
          >
            Every number on this site, with its source →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Architecture / How it works -->
  <section id="how-it-works" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="02" label="How it works" meta="Inputs · core · outputs" />
      <div class="mb-14 max-w-3xl">
        <h2 class="text-display-sm md:text-display-md text-navy text-balance">One platform, every system on your floor.</h2>
        <p class="mt-4 text-muted max-w-2xl leading-relaxed">
          MESvantage sits at the centre of your manufacturing stack — ingesting data from ERP, quality, machines and metrology, and turning it into validated records, real-time intelligence, and customer-ready outputs.
        </p>
      </div>

      <!-- Architecture diagram (SVG, animated) -->
      <div class="bg-white border border-border rounded-2xl p-6 md:p-10 shadow-sm">
        <svg viewBox="0 0 1100 520" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="MESvantage architecture diagram">
          <defs>
            <linearGradient id="centerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0F2D52" />
              <stop offset="100%" stop-color="#1A7FBF" />
            </linearGradient>
            <linearGradient id="flowIn" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#1A7FBF" stop-opacity="0" />
              <stop offset="50%" stop-color="#1A7FBF" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#1A7FBF" stop-opacity="0" />
            </linearGradient>
            <filter id="glow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>

          <!-- Column labels -->
          <text x="160" y="32" text-anchor="middle" fill="#64748B" font-size="11" font-weight="700" letter-spacing="2">YOUR INPUTS</text>
          <text x="550" y="32" text-anchor="middle" fill="#64748B" font-size="11" font-weight="700" letter-spacing="2">MESVANTAGE PLATFORM</text>
          <text x="940" y="32" text-anchor="middle" fill="#64748B" font-size="11" font-weight="700" letter-spacing="2">YOUR OUTPUTS</text>

          <!-- LEFT: Input nodes -->
          {[
            { y: 70, label: 'ERP', sub: 'M1 · SAP · Plex · Infor · Oracle' },
            { y: 150, label: 'QMS', sub: 'Qualio · MasterControl · Greenlight' },
            { y: 230, label: 'Machines', sub: 'OPC-UA · MTConnect · Modbus' },
            { y: 310, label: 'CMMs', sub: 'Renishaw · Hexagon · Zeiss' },
            { y: 390, label: 'Documents', sub: 'OneDrive · SharePoint · Google Drive' },
          ].map(node => (
            <g>
              <rect x="20" y={node.y} width="280" height="60" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
              <text x="40" y={node.y + 28} fill="#0F2D52" font-size="15" font-weight="700">{node.label}</text>
              <text x="40" y={node.y + 47} fill="#64748B" font-size="11">{node.sub}</text>
              <circle cx="300" cy={node.y + 30} r="4" fill="#1A7FBF"/>
            </g>
          ))}

          <!-- CENTER: MESvantage core -->
          <rect x="380" y="100" width="340" height="320" rx="18" fill="url(#centerGrad)" filter="url(#glow)"/>
          <text x="550" y="138" text-anchor="middle" fill="white" font-size="20" font-weight="800" letter-spacing="0.5">MESvantage</text>
          <text x="550" y="158" text-anchor="middle" fill="rgba(255,255,255,0.65)" font-size="11" letter-spacing="1.5">PLATFORM CORE</text>

          {[
            { y: 192, label: 'Device History Records (DHR)' },
            { y: 222, label: 'Genealogy & Traceability' },
            { y: 252, label: 'OEE & Downtime Intelligence' },
            { y: 282, label: 'FAI · Inspections · NCR · CAPA' },
            { y: 312, label: 'Scheduling & Standard Times' },
            { y: 342, label: 'Audit Trail & E-Signatures' },
            { y: 372, label: 'AI Assistant' },
          ].map(item => (
            <g>
              <rect x="408" y={item.y - 12} width="284" height="22" rx="6" fill="rgba(255,255,255,0.08)"/>
              <text x="420" y={item.y + 3} fill="white" font-size="12" font-weight="500">{item.label}</text>
            </g>
          ))}

          <circle cx="380" cy="260" r="4" fill="#1A7FBF"/>
          <circle cx="720" cy="260" r="4" fill="#1A7FBF"/>

          <!-- RIGHT: Output nodes -->
          {[
            { y: 110, label: 'OEM Customer Portals', sub: 'Lot release · DHR · Quality data' },
            { y: 190, label: 'Floor & Mobile', sub: 'PWA · Digital Signage · Operator UX' },
            { y: 270, label: 'Executive Intelligence', sub: 'Power BI · CEO dashboards' },
            { y: 350, label: 'Regulatory Packets', sub: 'IQ/OQ/PQ · Validation evidence' },
          ].map(node => (
            <g>
              <rect x="800" y={node.y} width="280" height="60" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
              <text x="820" y={node.y + 28} fill="#0F2D52" font-size="15" font-weight="700">{node.label}</text>
              <text x="820" y={node.y + 47} fill="#64748B" font-size="11">{node.sub}</text>
              <circle cx="800" cy={node.y + 30} r="4" fill="#1A7FBF"/>
            </g>
          ))}

          <!-- Animated flow paths: inputs -> core -->
          {[100, 180, 260, 340, 420].map((y, i) => (
            <g>
              <path d={`M 304 ${y} Q 342 ${y}, 360 260 T 380 260`} stroke="#CBD5E1" stroke-width="1.5" fill="none" opacity="0.4"/>
              <path d={`M 304 ${y} Q 342 ${y}, 360 260 T 380 260`} stroke="url(#flowIn)" stroke-width="2.5" fill="none" stroke-dasharray="8 200" stroke-dashoffset="0">
                <animate attributeName="stroke-dashoffset" from="0" to="-208" dur={`${2.4 + i * 0.18}s`} repeatCount="indefinite"/>
              </path>
            </g>
          ))}

          <!-- Animated flow paths: core -> outputs -->
          {[140, 220, 300, 380].map((y, i) => (
            <g>
              <path d={`M 720 260 Q 740 260, 760 ${y} T 800 ${y}`} stroke="#CBD5E1" stroke-width="1.5" fill="none" opacity="0.4"/>
              <path d={`M 720 260 Q 740 260, 760 ${y} T 800 ${y}`} stroke="url(#flowIn)" stroke-width="2.5" fill="none" stroke-dasharray="8 200" stroke-dashoffset="0">
                <animate attributeName="stroke-dashoffset" from="0" to="-208" dur={`${2.6 + i * 0.2}s`} repeatCount="indefinite"/>
              </path>
            </g>
          ))}

          <!-- Footer label inside core -->
          <text x="550" y="408" text-anchor="middle" fill="rgba(255,255,255,0.72)" font-size="9" letter-spacing="1.2" font-family="JetBrains Mono Variable, ui-monospace, monospace">ONE ENVIRONMENT PER CUSTOMER</text>
        </svg>
      </div>

      <p class="text-sm text-muted mt-6 max-w-2xl leading-relaxed">
        Each customer runs in a dedicated deployment: separate compute, database and storage. Isolation is not a regulatory requirement, but it keeps your audit scope simple and your data unambiguously yours.
      </p>
    </div>
  </section>

  <!--
    REMOVED 2026-07-27: "Screenshot callout" section.
    It rendered /screenshots/intelligence-dashboard.svg — a grey placeholder box whose only
    visible text was "[ Screenshot placeholder — replace with real anonymised PNG ]" — directly
    beneath the headline "Not a demo. Not a pilot." and the line "What you see is what you get."
    The alt text and caption both described content that did not exist.
    Replacement: real captures from the declared demo tenant (Phase 9/10 of the roadmap).
    Do not reinstate this section without a real image and a provenance manifest entry.
  -->

  <!-- The gap we fill -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="03" label="Why this one" />
      <h2 class="text-display-sm md:text-display-md text-navy max-w-2xl text-balance">
        The gap nobody else fills.
      </h2>
      <ul class="mt-12 list-none">
        {[
          {
            title: 'Purpose-built for CDMOs',
            body: 'Not a generic MES retrofitted to medical. Every workflow — DHR, FAI, CMM, OEE, NCR, lot release — was designed for regulated contract manufacturing from day one.',
          },
          {
            title: 'Validation you execute, not author',
            body: 'IQ/OQ/PQ has been executed for MESvantage at our founding customer\'s site, under their quality system. You still own validation — no supplier can discharge it. We supply the protocols, test scripts, traceability matrix and executed reference evidence so your team executes rather than writes.',
          },
          {
            title: 'Production-grade',
            body: 'Running daily in an orthopaedic plant that is FDA-registered and ISO 13485-certified — the plant’s credentials, not ours. Every feature in the validated scope has run on a real production floor — not a lab, not a pilot, not a demo environment.',
          },
        ].map((card, i) => (
          <li class="ruled last:border-b last:border-rule">
            <div class="grid md:grid-cols-12 gap-x-8 gap-y-2 py-7">
              <span class="index-num md:col-span-1 pt-1">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="md:col-span-4 text-lg font-bold text-navy leading-snug">{card.title}</h3>
              <p class="md:col-span-7 text-ink/75 leading-relaxed">{card.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    Founder quote.

    Was centred under a large decorative quotation-mark glyph, with the speaker's initials in a
    grey circle — the stock testimonial block, which is the last treatment this particular
    quote should have. It is a related-party reference and the page says so; dressing it as a
    customer testimonial works against the disclosure sitting directly underneath it.

    Left-aligned, opened by a hairline, attributed in mono like a signature line on a record.
  */}
  <section class="py-20 px-6 bg-surface border-b border-rule">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="04" label="Why it exists" meta="Related-party, disclosed" />
    </div>
    <div class="max-w-6xl mx-auto grid md:grid-cols-12 gap-x-10 gap-y-8">
      <div class="md:col-span-3">
        <p class="mt-4 font-mono text-sm font-semibold text-navy">Patrick Byrnes</p>
        <p class="mt-1 text-sm text-muted leading-snug">
          CEO, Croom Medical<br />Founder, MESvantage
        </p>
      </div>

      <div class="md:col-span-9">
        <blockquote class="text-xl md:text-2xl text-navy leading-[1.45] tracking-[-0.01em]">
          We spent two years looking for an MES that understood a knee. Everything we found was a
          QMS pretending to be an MES, a platform we would have had to build ourselves, or a
          two-year programme priced for a company ten times our size. So we built it, we validated
          it, and we ran our plant on it. This is that system — not a version of it, not a
          demonstration of it. The same one.
        </blockquote>

        <p class="mt-10 pt-6 border-t border-rule text-sm text-ink/75 leading-relaxed max-w-3xl">
          <span class="font-semibold text-navy">A disclosure, because you would find it anyway.</span>
          MESvantage Limited and Croom Medical share a founder and chief executive. Croom is our
          only customer to date, so this is a related-party reference and we describe it as one.
          What is not related-party is the record: the system has been in scope for external audits
          of an FDA-registered, ISO 13485-certified plant, and Croom's quality manager will take
          your call.
        </p>
      </div>
    </div>
  </section>

  <!-- Mockup scene: Operations dashboard (HTML/CSS, MESvantage-branded, fake data) -->
  <!-- Mockup scene: Machine Intelligence -->
  <section class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="05" label="Condition monitoring" meta="OPC-UA · MTConnect · Modbus" />
      <div class="grid md:grid-cols-12 gap-x-12 gap-y-6 mb-0">
        <div class="md:col-span-5">
          <h2 class="mt-1 text-display-sm text-navy text-balance">
            Every connected machine, every shift, on one screen.
          </h2>
          <p class="mt-4 text-ink/70 leading-relaxed">
            Live ingestion from OPC-UA, MTConnect and Modbus. Machine state, utilisation and downtime reasons
            are captured as they happen and surfaced per cell, per work centre and across the fleet — with
            threshold and trend alerting on the signals your maintenance team already watches.
          </p>
        </div>

        <ul class="md:col-span-6 md:col-start-7 list-none self-center">
          {[
            'Real-time OEE per cell, work centre, and fleet',
            'Downtime reasons captured by operators at the machine',
            'Threshold and trend alerting on temperature, cycle and feed',
            'Maintenance work orders drafted for a person to approve',
            'Before we quote, we survey your machines and tell you which can be read on day one',
          ].map(item => (
            <li class="ruled last:border-b last:border-rule py-3 text-ink/80 leading-relaxed">
              {item}
            </li>
          ))}
        </ul>

        <!-- Browser mockup -->

      </div>
    </div>
  </section>

  <!-- Mockup scene: AI Assistant -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="06" label="Intelligence, governed" meta="Read and draft · never release" />
      <div class="grid md:grid-cols-12 gap-x-12 gap-y-6">
        <div class="md:col-span-5">
          <h2 class="mt-1 text-display-sm text-navy text-balance">
            People sign. The system proves.
          </h2>
          <p class="mt-4 text-ink/70 leading-relaxed">
            An assistant grounded in your own records. It answers using retrieval over your MESvantage data
            and links to the source record behind each statement. It is a read-and-draft tool: it cannot
            approve, sign, disposition or release anything.
          </p>
        </div>

        <ul class="md:col-span-6 md:col-start-7 list-none self-center">
          {[
            'Your data is never used to train models — ours or a third party’s',
            'Retrieval is scoped to your tenant; answers link to the underlying records',
            'Drafts only — a qualified user reviews and signs; nothing takes effect without approval',
            'Barred in software from releasing product, dispositioning parts or closing a quality record',
            'Every response is written to the audit trail with its question, sources and model version',
          ].map(item => (
            <li class="ruled last:border-b last:border-rule py-3 text-ink/80 leading-relaxed">
              {item}
            </li>
          ))}
        </ul>

            </div>

      <div class="mt-16 glow-panel">
        <ProductScreenshot
          image="spc-desktop.png"
          caption="Statistical process control — characteristic-level, with control limits"
        />
      </div>
    </div>
  </section>

  <!-- Mockup scene: Genealogy & DHR -->
  <section class="py-24 px-6 bg-navy text-white">
    <div class="max-w-6xl mx-auto">
      <SpecHeader index="07" label="Genealogy & DHR" meta="Raw stock to dispatch" onDark />
      <div class="grid md:grid-cols-12 gap-x-12 gap-y-6">
        <div class="md:col-span-5">
          <h2 class="mt-1 text-display-sm text-white text-balance">
            Every part. Every operation. Every signature.
          </h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            Trace a single serial number from raw stock to dispatch in two clicks — assembled as
            the part is made, rather than reconstructed afterwards.
          </p>
        </div>

        <ul class="md:col-span-6 md:col-start-7 list-none self-center">
          {[
            'Forward and backward trace from any lot or serial',
            'Raw material certificate bound to the parts it became',
            'Every operation, gauge and signature on the record it belongs to',
            'The device history record assembled as work happens, not afterwards',
            'Audit trail filterable to a single record, exportable as evidence',
          ].map(item => (
            <li class="ruled-on-dark last:border-b last:border-rule-onDark py-3 text-muted-onDark leading-relaxed">
              {item}
            </li>
          ))}
        </ul>

            </div>

