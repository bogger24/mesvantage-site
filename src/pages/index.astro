---
import BaseLayout from '../layouts/BaseLayout.astro';
import Evidence from '../components/Evidence.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import { claims } from '../data/claims';
---

<BaseLayout
  title="MES for orthopaedic implant manufacturers"
  description="The manufacturing execution system for orthopaedic implant manufacturers — built inside a live knee-implant plant and validated there in production."
>

  <!-- Hero -->
  <section class="bg-navy text-white pt-24 pb-20 px-6 overflow-hidden relative">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none grid-overlay"></div>
    <div class="max-w-5xl mx-auto text-center relative">
      <div class="inline-flex items-center gap-2 bg-accent/15 border border-accent/30 rounded-full px-4 py-1.5 text-xs font-semibold text-accent-onDark tracking-wide uppercase mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        Orthopaedic implant manufacturing
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.05] tracking-tight">
        Every implant. Every operation.<br class="hidden md:block" /> Every signature. One record.
      </h1>
      <p class="mt-7 text-lg md:text-xl text-white/70 max-w-3xl mx-auto leading-relaxed">
        MESvantage is the manufacturing execution and intelligence system built inside a live
        <Evidence claim="plant-volume" variant="inline" />-knee-a-year
        orthopaedic plant in Ireland — and validated there, in production, under that site's
        ISO 13485 quality system. Audit preparation stops being an archaeology project.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/mesvantage-product-overview.pdf"
           class="bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-md transition-colors">
          Download the product overview
        </a>
        <a href="/about#contact" class="border border-white/30 hover:border-white text-white font-semibold px-8 py-3.5 rounded-md transition-colors">
          Book a Demo
        </a>
      </div>
    </div>
  </section>

  <!-- Pain recognition -->
  <section class="py-20 px-6 bg-white border-b border-border">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-widest text-accent uppercase">Does this sound familiar?</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold text-navy">The problems every CDMO lives with.</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
            title: 'Audit prep is a 3-week fire drill',
            body: 'Every FDA or notified body visit means weeks of pulling records, chasing paper travellers, and reconstructing device history from spreadsheets and shared drives.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
            title: "You can't see your floor in real time",
            body: 'Machine status, OEE, active jobs, operator positions — none of it is visible until someone walks the floor or checks a whiteboard at shift handover.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>`,
            title: 'Your quality system is a shared drive',
            body: 'FAIs, NCRs, CAPAs, incoming inspection results — scattered across SharePoint folders, email threads, and institutional knowledge that leaves when people leave.',
          },
        ].map(card => (
          <div class="bg-surface border border-border rounded-xl p-8">
            <div class="w-10 h-10 rounded-lg bg-accent/10 text-accent flex items-center justify-center mb-5" aria-hidden="true" set:html={card.icon} />
            <h3 class="text-lg font-bold text-navy mb-3">{card.title}</h3>
            <p class="text-ink/70 leading-relaxed text-sm">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/*
    Facts band. Replaced the previous outcomes band (90d / ~70% / ~75% / €0) on 2026-07-27.
    Those four were unsourced outcome claims and one of them — "€0 Validation Budget" — was
    false: under ISO 13485 §4.1.6 and the FDA QMSR, validating software for intended use is the
    device manufacturer's obligation and no supplier can discharge it.
    Rule from here: counts, not percentages. A hostile reader can argue with a percentage; they
    cannot argue with a count. No percentage returns to this page until it has been measured,
    with a stated method, signed off by the person who measured it.
  */}
  <section class="bg-navy/5 border-b border-border">
    <div class="max-w-6xl mx-auto px-6 py-14">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center">
        <Evidence claim="plant-volume" />
        <Evidence claim="module-count" />
        <Evidence claim="validation-tests" />
        <Evidence claim="validation-rtm" />
        <Evidence claim="ortho-vendor-count" />
      </div>
      <p data-evidence="ortho-vendor-count" class="text-center text-sm text-muted mt-8 max-w-3xl mx-auto">
        On that last one: we looked across eighteen platforms and roughly three hundred sources in
        July 2026 and could not find another MES vendor with a named orthopaedic implant machining
        customer. <span class="font-semibold text-navy">If you can name one, tell us and we will publish it here.</span>
        <a href="/evidence" class="block mt-3 font-semibold text-accent hover:text-accent-dark">Every number on this site, with its source →</a>
      </p>
    </div>
  </section>

  <!-- Architecture / How it works -->
  <section id="how-it-works" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <span class="text-xs font-bold tracking-widest text-accent uppercase">How it works</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold text-navy">One platform, every system on your floor.</h2>
        <p class="mt-4 text-muted max-w-2xl mx-auto">
          MESvantage sits at the centre of your manufacturing stack — ingesting data from ERP, quality, machines and metrology, and turning it into validated records, real-time intelligence, and customer-ready outputs.
        </p>
      </div>

      <!-- Architecture diagram (SVG, animated) -->
      <div class="bg-white border border-border rounded-2xl p-6 md:p-10 shadow-sm">
        <svg viewBox="0 0 1100 520" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="MESvantage architecture diagram">
          <defs>
            <linearGradient id="centerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0F2D52" />
              <stop offset="100%" stop-color="#1A7FBF" />
            </linearGradient>
            <linearGradient id="flowIn" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#1A7FBF" stop-opacity="0" />
              <stop offset="50%" stop-color="#1A7FBF" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#1A7FBF" stop-opacity="0" />
            </linearGradient>
            <filter id="glow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>

          <!-- Column labels -->
          <text x="160" y="32" text-anchor="middle" fill="#64748B" font-size="11" font-weight="700" letter-spacing="2">YOUR INPUTS</text>
          <text x="550" y="32" text-anchor="middle" fill="#64748B" font-size="11" font-weight="700" letter-spacing="2">MESVANTAGE PLATFORM</text>
          <text x="940" y="32" text-anchor="middle" fill="#64748B" font-size="11" font-weight="700" letter-spacing="2">YOUR OUTPUTS</text>

          <!-- LEFT: Input nodes -->
          {[
            { y: 70, label: 'ERP', sub: 'M1 · SAP · Plex · Infor · Oracle' },
            { y: 150, label: 'QMS', sub: 'Qualio · MasterControl · Greenlight' },
            { y: 230, label: 'Machines', sub: 'OPC-UA · MTConnect · Modbus' },
            { y: 310, label: 'CMMs', sub: 'Renishaw · Hexagon · Zeiss' },
            { y: 390, label: 'Documents', sub: 'OneDrive · SharePoint · Google Drive' },
          ].map(node => (
            <g>
              <rect x="20" y={node.y} width="280" height="60" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
              <text x="40" y={node.y + 28} fill="#0F2D52" font-size="15" font-weight="700">{node.label}</text>
              <text x="40" y={node.y + 47} fill="#64748B" font-size="11">{node.sub}</text>
              <circle cx="300" cy={node.y + 30} r="4" fill="#1A7FBF"/>
            </g>
          ))}

          <!-- CENTER: MESvantage core -->
          <rect x="380" y="100" width="340" height="320" rx="18" fill="url(#centerGrad)" filter="url(#glow)"/>
          <text x="550" y="138" text-anchor="middle" fill="white" font-size="20" font-weight="800" letter-spacing="0.5">MESvantage</text>
          <text x="550" y="158" text-anchor="middle" fill="rgba(255,255,255,0.65)" font-size="11" letter-spacing="1.5">PLATFORM CORE</text>

          {[
            { y: 192, label: 'Device History Records (DHR)' },
            { y: 222, label: 'Genealogy & Traceability' },
            { y: 252, label: 'OEE & Downtime Intelligence' },
            { y: 282, label: 'FAI · Inspections · NCR · CAPA' },
            { y: 312, label: 'Scheduling & Standard Times' },
            { y: 342, label: 'Audit Trail & E-Signatures' },
            { y: 372, label: 'AI Assistant' },
          ].map(item => (
            <g>
              <rect x="408" y={item.y - 12} width="284" height="22" rx="6" fill="rgba(255,255,255,0.08)"/>
              <text x="420" y={item.y + 3} fill="white" font-size="12" font-weight="500">{item.label}</text>
            </g>
          ))}

          <circle cx="380" cy="260" r="4" fill="#1A7FBF"/>
          <circle cx="720" cy="260" r="4" fill="#1A7FBF"/>

          <!-- RIGHT: Output nodes -->
          {[
            { y: 110, label: 'OEM Customer Portals', sub: 'Lot release · DHR · Quality data' },
            { y: 190, label: 'Floor & Mobile', sub: 'PWA · Digital Signage · Operator UX' },
            { y: 270, label: 'Executive Intelligence', sub: 'Power BI · CEO dashboards' },
            { y: 350, label: 'Regulatory Packets', sub: 'IQ/OQ/PQ · Validation evidence' },
          ].map(node => (
            <g>
              <rect x="800" y={node.y} width="280" height="60" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
              <text x="820" y={node.y + 28} fill="#0F2D52" font-size="15" font-weight="700">{node.label}</text>
              <text x="820" y={node.y + 47} fill="#64748B" font-size="11">{node.sub}</text>
              <circle cx="800" cy={node.y + 30} r="4" fill="#1A7FBF"/>
            </g>
          ))}

          <!-- Animated flow paths: inputs -> core -->
          {[100, 180, 260, 340, 420].map((y, i) => (
            <g>
              <path d={`M 304 ${y} Q 342 ${y}, 360 260 T 380 260`} stroke="#CBD5E1" stroke-width="1.5" fill="none" opacity="0.4"/>
              <path d={`M 304 ${y} Q 342 ${y}, 360 260 T 380 260`} stroke="url(#flowIn)" stroke-width="2.5" fill="none" stroke-dasharray="8 200" stroke-dashoffset="0">
                <animate attributeName="stroke-dashoffset" from="0" to="-208" dur={`${2.4 + i * 0.18}s`} repeatCount="indefinite"/>
              </path>
            </g>
          ))}

          <!-- Animated flow paths: core -> outputs -->
          {[140, 220, 300, 380].map((y, i) => (
            <g>
              <path d={`M 720 260 Q 740 260, 760 ${y} T 800 ${y}`} stroke="#CBD5E1" stroke-width="1.5" fill="none" opacity="0.4"/>
              <path d={`M 720 260 Q 740 260, 760 ${y} T 800 ${y}`} stroke="url(#flowIn)" stroke-width="2.5" fill="none" stroke-dasharray="8 200" stroke-dashoffset="0">
                <animate attributeName="stroke-dashoffset" from="0" to="-208" dur={`${2.6 + i * 0.2}s`} repeatCount="indefinite"/>
              </path>
            </g>
          ))}

          <!-- Footer label inside core -->
          <text x="550" y="408" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="10" letter-spacing="2">SILOED SAAS · DEDICATED ENVIRONMENT PER CUSTOMER</text>
        </svg>
      </div>

      <p class="text-center text-sm text-muted mt-6 max-w-2xl mx-auto">
        Each customer runs in a dedicated deployment: separate compute, database and storage. Isolation is not a regulatory requirement, but it keeps your audit scope simple and your data unambiguously yours.
      </p>
    </div>
  </section>

  <!--
    REMOVED 2026-07-27: "Screenshot callout" section.
    It rendered /screenshots/intelligence-dashboard.svg — a grey placeholder box whose only
    visible text was "[ Screenshot placeholder — replace with real anonymised PNG ]" — directly
    beneath the headline "Not a demo. Not a pilot." and the line "What you see is what you get."
    The alt text and caption both described content that did not exist.
    Replacement: real captures from the declared demo tenant (Phase 9/10 of the roadmap).
    Do not reinstate this section without a real image and a provenance manifest entry.
  -->

  <!-- The gap we fill -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-navy text-center mb-12">
        The gap nobody else fills.
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            title: 'Purpose-built for CDMOs',
            body: 'Not a generic MES retrofitted to medical. Every workflow — DHR, FAI, CMM, OEE, NCR, lot release — was designed for regulated contract manufacturing from day one.',
          },
          {
            title: 'Validation you execute, not author',
            body: 'IQ/OQ/PQ has been executed for MESvantage at our founding customer\'s site, under their quality system. You still own validation — no supplier can discharge it. We supply the protocols, test scripts, traceability matrix and executed reference evidence so your team executes rather than writes.',
          },
          {
            title: 'Production-grade',
            body: 'Running daily in an orthopaedic plant that is FDA-registered and ISO 13485-certified — the plant’s credentials, not ours. Every feature in the validated scope has run on a real production floor — not a lab, not a pilot, not a demo environment.',
          },
        ].map(card => (
          <div class="bg-surface border border-border rounded-xl p-8">
            <h3 class="text-lg font-bold text-navy mb-3">{card.title}</h3>
            <p class="text-ink/70 leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder quote -->
  <section class="py-20 px-6 bg-surface border-b border-border">
    <div class="max-w-3xl mx-auto text-center">
      <svg class="w-10 h-10 text-accent/40 mx-auto mb-6" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M10 8C6.686 8 4 10.686 4 14v10h10V14H7c0-1.657 1.343-3 3-3V8zm18 0c-3.314 0-6 2.686-6 6v10h10V14h-7c0-1.657 1.343-3 3-3V8z"/>
      </svg>
      <blockquote class="text-xl md:text-2xl font-medium text-navy leading-relaxed">
        "We spent two years looking for an MES that understood a knee. Everything we found was a QMS
        pretending to be an MES, a platform we would have had to build ourselves, or a two-year
        programme priced for a company ten times our size. So we built it, we validated it, and we
        ran our plant on it. This is that system — not a version of it, not a demonstration of it.
        The same one."
      </blockquote>
      <div class="mt-8 flex items-center justify-center gap-4">
        <div class="w-12 h-12 rounded-full bg-navy/10 flex items-center justify-center text-navy font-bold text-lg">PB</div>
        <div class="text-left">
          <div class="font-bold text-navy">Patrick Byrnes</div>
          <div class="text-sm text-ink/70">CEO, Croom Medical · Founder, MESvantage</div>
        </div>
      </div>
      <p class="mt-8 text-sm text-ink/70 leading-relaxed max-w-2xl mx-auto border-t border-border pt-6">
        <span class="font-semibold text-navy">A disclosure, because you would find it anyway.</span>
        MESvantage Limited and Croom Medical share a founder and chief executive. Croom is our only
        customer to date, so this is a related-party reference and we describe it as one. What is not
        related-party is the record: the system has been in scope for external audits of an
        FDA-registered, ISO 13485-certified plant, and Croom's quality manager will take your call.
      </p>
    </div>
  </section>

  <!-- Mockup scene: Operations dashboard (HTML/CSS, MESvantage-branded, fake data) -->
  <section class="py-24 px-6 bg-navy">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-widest text-accent-onDark uppercase">The platform</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold text-white">Real-time intelligence. Without the Excel.</h2>
        <p class="mt-4 text-white/60 max-w-2xl mx-auto">
          See your shop floor the way your CEO wants to see it: live, drillable, audit-ready.
        </p>
      </div>

      <!-- Browser chrome -->
      <ProductScreenshot image="site-board-desktop.png" caption="The site board — what the floor is doing right now" tone="dark" />


      <p class="text-center text-xs text-muted-onDark mt-6 italic">
        Illustration rendered with synthetic data. Each MESvantage deployment runs in its own isolated environment.
      </p>
    </div>
  </section>

  <!-- Mockup scene: Machine Intelligence -->
  <section class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-12">
        <div>
          <span class="text-xs font-bold tracking-widest text-accent uppercase">Machine condition monitoring</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold text-navy leading-tight">
            Every connected machine, every shift, on one screen.
          </h2>
          <p class="mt-4 text-ink/70 leading-relaxed">
            Live ingestion from OPC-UA, MTConnect and Modbus. Machine state, utilisation and downtime reasons
            are captured as they happen and surfaced per cell, per work centre and across the fleet — with
            threshold and trend alerting on the signals your maintenance team already watches.
          </p>
          <ul class="mt-6 space-y-2 text-sm">
            {[
              'Real-time OEE per cell, work centre, and fleet',
              'Downtime reasons captured by operators at the machine',
              'Threshold and trend alerting on temperature, cycle and feed',
              'Maintenance work orders drafted for a person to approve',
              'Before we quote, we survey your machines and tell you which can be read on day one',
            ].map(item => (
              <li class="flex items-start gap-2 text-ink/80">
                <span class="text-accent font-bold mt-0.5">▸</span>{item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Browser mockup -->
      <ProductScreenshot image="machine-intel-desktop.png" caption="Machine condition monitoring — state, utilisation and downtime reasons per cell" tone="light" />

      </div>
    </div>
  </section>

  <!-- Mockup scene: AI Assistant -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Browser mockup (dark) -->
        <ProductScreenshot image="assistant-desktop.png" caption="The assistant answers from your own records and links to the source behind each statement" />


        <!-- Copy -->
        <div class="order-1 md:order-2">
          <span class="text-xs font-bold tracking-widest text-accent uppercase">Intelligence, governed</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold text-navy leading-tight">
            People sign. The system proves.
          </h2>
          <p class="mt-4 text-ink/70 leading-relaxed">
            An assistant grounded in your own records. It answers using retrieval over your MESvantage data
            and links to the source record behind each statement. It is a read-and-draft tool: it cannot
            approve, sign, disposition or release anything.
          </p>
          <ul class="mt-6 space-y-2 text-sm">
            {[
              'Your data is never used to train models — ours or a third party’s',
              'Retrieval is scoped to your tenant; answers link to the underlying records',
              'Drafts only — a qualified user reviews and signs; nothing takes effect without approval',
              'Barred in software from releasing product, dispositioning parts or closing a quality record',
              'Every response is written to the audit trail with its question, sources and model version',
            ].map(item => (
              <li class="flex items-start gap-2 text-ink/80">
                <span class="text-accent font-bold mt-0.5">▸</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mockup scene: Genealogy & DHR -->
  <section class="py-24 px-6 bg-navy text-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-widest text-accent-onDark uppercase">Genealogy & DHR</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold text-white">Every part. Every operation. Every signature.</h2>
        <p class="mt-4 text-white/60 max-w-2xl mx-auto">
          Trace a single serial number from raw stock to dispatch in two clicks — assembled as the part is made, rather than reconstructed afterwards.
        </p>
      </div>

      <!-- Browser mockup -->
      <ProductScreenshot image="genealogy-desktop.png" caption="Lot genealogy — trace a lot back to its raw material, or forward to every product it touched" tone="dark" />
    </div>
  </section>

  <!-- Module highlights -->
  <section class="py-24 px-6 bg-white border-b border-border">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <span class="text-xs font-bold tracking-widest text-accent uppercase">The platform</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold text-navy"><Evidence claim="module-count" variant="inline" /> modules. Six domains.</h2>
        <p class="mt-4 text-muted max-w-xl mx-auto">
          Every module was written for regulated contract manufacturing, not retrofitted from a generic platform. Each one carries a label saying whether it is live in production today.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            domain: 'Quality', num: '01',
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
            outcome: 'From incoming inspection to lot release — every quality record signed, traceable, and audit-ready under 21 CFR Part 11.',
          },
          {
            domain: 'Production', num: '02',
