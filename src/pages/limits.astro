---
import BaseLayout from '../layouts/BaseLayout.astro';
import Evidence from '../components/Evidence.astro';

const updated = '28 July 2026';

/**
 * The point of this page is that it is not a marketing page.
 *
 * Everything here is a real gap. If something moves out of the "Not yet" column it moves
 * because it shipped, not because the copy softened. Anyone reviewing a change to this file
 * should ask for the artefact that justifies the move.
 */

type Status = 'no' | 'partial' | 'planned';

interface Limit {
  title: string;
  status: Status;
  detail: string;
}

const groups: { heading: string; blurb: string; items: Limit[] }[] = [
  {
    heading: 'Company and track record',
    blurb: 'The things a procurement process will find anyway.',
    items: [
      {
        title: 'We have one customer',
        status: 'no',
        detail:
          'MESvantage runs in production at Croom Medical, an ISO 13485-certified, FDA-registered orthopaedic implant manufacturer. Croom is also the company the founder runs. That is a real conflict of interest and we would rather you heard it from us. What it buys you is that the system was built under audit conditions by the people who had to pass the audit. What it does not buy you is a second reference, and we will not pretend otherwise until there is one.',
      },
      {
        title: 'No multi-site deployment has been done',
        status: 'no',
        detail:
          'Every line of this system has been exercised on one site. Multi-site tenancy, cross-site reporting and site-scoped permissions exist in the data model and have never been run in anger. If you are a multi-site group, we are the wrong supplier this year.',
      },
      {
        title: 'No independent penetration test',
        status: 'planned',
        detail:
          'None has been commissioned yet. When one is, we will publish the summary letter here including findings, whether or not they are flattering. Until then, treat our security posture as untested by anyone outside the company.',
      },
      {
        title: 'No SOC 2 and no ISO 27001',
        status: 'no',
        detail:
          'We hold neither. If your supplier approval process requires one as a gate rather than as a risk input, we will fail it, and you should not spend a call finding that out.',
      },
    ],
  },
  {
    heading: 'The product',
    blurb: 'What is live, what is thin, and what is not there.',
    items: [
      {
        title: 'Some screens read your ERP live, so a demo cannot show them populated',
        status: 'partial',
        detail:
          'The production dashboard, work orders and several quality counters query the ERP directly rather than a mirror. That is deliberate — it means you are never looking at a stale copy — but it also means those screens are empty in a demonstration environment with no ERP behind it, and we will not seed them with invented jobs to make a screenshot look better. When you see those screens, they will be showing your data.',
      },
      {
        title: 'Barcode scanning is off',
        status: 'planned',
        detail:
          'Scanner input is implemented but disabled pending hardware qualification. Operators key identifiers today. If scanning is load-bearing for your floor, this is a date to write into the contract, not a feature to assume.',
      },
      {
        title: 'The intelligence layer is built and switched off',
        status: 'planned',
        detail:
          'The governed AI layer is deployed but dark by configuration. It stays dark until an evaluation set passes, a signed condition-of-use memo exists, and an e-signed model-release gate is built — the last of which is not built. We would rather ship it late than ship an ungoverned model into a regulated record.',
      },
      {
        title: 'The mobile experience is a responsive web app, not a native one',
        status: 'partial',
        detail:
          'It installs and it works. It is not a native application, there is no offline record capture, and a floor terminal is still the right device for signing.',
      },
      {
        title: 'Integrations beyond the ones we have built are work, not configuration',
        status: 'partial',
        detail:
          'We have real connectors to a specific ERP, specific CMM output formats and specific machine controllers. Anything outside that list is a scoped piece of engineering with a price and a date, not a checkbox. Ask before you assume, and we will tell you which of your machines can be read on day one and which need a cable.',
      },
    ],
  },
  {
    heading: 'Compliance and validation',
    blurb: 'The part most likely to be oversold in this market. It is not oversold here.',
    items: [
      {
        title: 'We cannot validate the system for you',
        status: 'no',
        detail:
          'Under ISO 13485 §4.1.6 and the FDA QMSR, validating software for its intended use in your quality system is your obligation as the manufacturer. It cannot be discharged by a supplier, and any vendor implying otherwise is describing a liability transfer that does not exist. What we can do is hand you the package — requirements, traceability, test protocols and executed evidence — so the exercise is a review rather than an archaeology project. The work is still yours.',
      },
      {
        title: 'No agency has validated, certified or approved this software',
        status: 'no',
        detail:
          'The FDA does not validate, certify or approve software products at all — there is no such programme, for us or for anyone. This website used to imply otherwise. That was wrong, we removed it, and the build now refuses to compile if anyone puts that phrasing back. If a supplier tells you their system carries an agency endorsement, ask them which one and who issued it.',
      },
      {
        title: 'Our validation evidence has not been independently reviewed',
        status: 'partial',
        detail:
          'The test cases and the requirements trace were executed and signed inside Croom. Croom has been externally audited with the system in scope, but no third party has been engaged specifically to review the validation package itself. Two of the figures we quote for it are still marked as evidence-pending on our own evidence page, because the artefacts have not been assembled for publication.',
      },
      {
        title: 'We deploy continuously, which is a question you should ask us',
        status: 'partial',
        detail:
          'A continuously-deployed system inside a validated environment needs a release classification, a GxP impact assessment per release, defined regression triggers, and a customer notification lead time with a right to defer. We operate this today. We have not yet published the document, and until we do you should treat our answer as unverified.',
      },
    ],
  },
];

const label: Record<Status, string> = {
  no: 'Not available',
  partial: 'Partial',
  planned: 'Planned',
};

const chip: Record<Status, string> = {
  no: 'bg-rose-50 text-rose-900 border-rose-200',
  partial: 'bg-amber-50 text-amber-900 border-amber-200',
  planned: 'bg-sky-50 text-sky-900 border-sky-200',
};

const counts = {
  no: groups.flatMap((g) => g.items).filter((i) => i.status === 'no').length,
  partial: groups.flatMap((g) => g.items).filter((i) => i.status === 'partial').length,
  planned: groups.flatMap((g) => g.items).filter((i) => i.status === 'planned').length,
};
---

<BaseLayout
  title="What we don't do yet"
  description="An honest list of what MESvantage does not have, what is only partly there, and what is planned — written by us, before you find it in due diligence."
>
  <section class="bg-navy text-white py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <span class="text-xs font-bold tracking-widest text-accent-onDark uppercase">Limits</span>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold leading-tight">
        What we don't do yet.
      </h1>
      <p class="mt-6 text-lg text-white/90 leading-relaxed">
        We are an early-stage company with one customer. This page tells you exactly what we
        have, what we are building, and what we do not have. If something you require is in the
        <span class="font-semibold text-white">Not available</span> column, tell us — we will
        either commit to a date in the contract or say plainly that we can't. We would rather
        lose a deal than be discovered mid-implementation.
      </p>
      <p class="mt-5 text-muted-onDark text-sm">
        Last updated {updated}. Nothing leaves this page because the wording improved.
      </p>
    </div>
  </section>

  <section class="py-12 px-6 border-b border-ink/10">
    <div class="max-w-3xl mx-auto">
      <dl class="grid grid-cols-3 gap-6 text-center">
        <div>
          <dt class="sr-only">Not available</dt>
          <dd class="text-2xl md:text-3xl font-extrabold text-navy tabular-nums">{counts.no}</dd>
          <p class="text-xs uppercase tracking-wider text-ink/70 mt-1 font-semibold">Not available</p>
        </div>
        <div>
          <dt class="sr-only">Partial</dt>
          <dd class="text-2xl md:text-3xl font-extrabold text-navy tabular-nums">{counts.partial}</dd>
          <p class="text-xs uppercase tracking-wider text-ink/70 mt-1 font-semibold">Partial</p>
        </div>
        <div>
          <dt class="sr-only">Planned</dt>
          <dd class="text-2xl md:text-3xl font-extrabold text-navy tabular-nums">{counts.planned}</dd>
          <p class="text-xs uppercase tracking-wider text-ink/70 mt-1 font-semibold">Planned</p>
        </div>
      </dl>
      <p class="mt-6 text-sm text-muted text-center">
        Against <Evidence claim="module-count" variant="inline" /> modules that are live and in
        daily use. Both of those things are true at the same time, and a supplier who shows you
        only the flattering one is showing you the wrong page.
      </p>
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="py-14 px-6 border-b border-ink/10 last:border-0">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-extrabold text-navy">{group.heading}</h2>
          <p class="mt-2 text-muted">{group.blurb}</p>

          <ul class="mt-8 space-y-6">
            {group.items.map((item) => (
              <li class="border border-ink/10 rounded-lg p-6 bg-white">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <h3 class="text-lg font-bold text-navy leading-snug">{item.title}</h3>
                  <span
                    class={`shrink-0 text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded border ${chip[item.status]}`}
                  >
                    {label[item.status]}
                  </span>
                </div>
                <p class="mt-3 text-ink/80 leading-relaxed">{item.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="py-16 px-6 bg-navy text-white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-extrabold">If we missed one, tell us</h2>
      <p class="mt-4 text-white/90 leading-relaxed">
        This page is maintained by the people who would be embarrassed by it, which is the only
        reason to believe it. If you evaluate MESvantage and find a gap that is not written here,
        send it to us and we will add it — including if you decide not to buy. A list of
        weaknesses that only ever gets shorter is not a list of weaknesses, it is marketing.
      </p>
      <p class="mt-6">
        <a
          href="mailto:hello@mesvantage.com?subject=A%20gap%20that%20isn%27t%20on%20your%20limits%20page"
          class="inline-block bg-white text-navy font-bold px-6 py-3 rounded-md hover:bg-white/90 transition-colors"
        >
          hello@mesvantage.com
        </a>
      </p>
      <p class="mt-8 text-sm text-muted-onDark">
        See also <a href="/evidence" class="underline underline-offset-2 hover:text-white">the evidence register</a>,
        which lists every number we publish along with its source — or with the fact that the
        source does not exist yet.
      </p>
    </div>
  </section>
</BaseLayout>
