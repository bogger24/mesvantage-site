---
import BaseLayout from '../layouts/BaseLayout.astro';
import Evidence from '../components/Evidence.astro';
import { claims } from '../data/claims';

const tiers = [
  {
    name: 'Essential',
    claim: 'price-essential' as const,
    highlight: false,
    modules: [
      'Quality (FAI, FPY, DHR, Incoming Inspection)',
      'Production (OEE, Scheduling)',
      'In-Process Documentation (IPD)',
      'Standard Times & Variance',
      'Training enforcement',
      'Mobile PWA',
      'Audit trail & electronic signatures',
      'Role-based access control',
    ],
  },
  {
    name: 'Professional',
    claim: 'price-professional' as const,
    highlight: true,
    modules: [
      'Everything in Essential',
      'Metrology / CMM AI parsing',
      'Energy Intelligence',
      'Customer Quality Portal',
      'SPC with alerting',
      'Advanced analytics',
      'Digital factory floor signage',
      'ERP integration (Infor M1 + others)',
    ],
  },
  {
    name: 'Enterprise',
    claim: 'price-enterprise' as const,
    highlight: false,
    modules: [
      'Everything in Professional',
      'CEO Intelligence Dashboard',
      'AI Executive Agent',
      'Custom ERP integration',
      'Dedicated Customer Success Manager',
      'Priority support SLA',
      'Custom reporting',
      'Multi-site licensing discounts',
    ],
  },
];
---

<BaseLayout
  title="Pricing"
  description="MESvantage pricing — Essential, Professional, and Enterprise tiers for medical device CDMOs."
>
  <section class="py-16 px-6 border-b border-border">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl font-extrabold text-navy">Simple, site-based pricing</h1>
      <p class="mt-4 text-lg text-ink/70 max-w-2xl mx-auto">
        Per-site annual subscription. No per-user fees. No hidden implementation surprises.
        Infrastructure is included.
      </p>
    </div>
  </section>

  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8 items-start">
      {tiers.map(tier => (
        <div class={`rounded-xl border p-8 flex flex-col gap-6 ${tier.highlight ? 'border-accent ring-2 ring-accent bg-white' : 'border-border bg-white'}`}>
          {tier.highlight && (
            <span class="text-xs font-bold tracking-widest text-accent uppercase">Most popular</span>
          )}
          <div>
            <h2 class="text-xl font-bold text-navy">{tier.name}</h2>
            <p class="mt-2 text-3xl font-extrabold text-navy">
              <span data-evidence={tier.claim} data-token={claims[tier.claim].token} class="tabular-nums">{claims[tier.claim].value}</span><span class="text-base font-normal text-muted">/yr</span>
            </p>
            <p class="mt-1 text-sm text-muted">Contact us for a tailored quote</p>
          </div>
          <ul class="flex flex-col gap-2 flex-1">
            {tier.modules.map(mod => (
              <li class="flex items-start gap-2 text-sm text-ink/80">
                <span class="text-accent font-bold mt-0.5">✓</span>
                {mod}
              </li>
            ))}
          </ul>
          <a
            href="/about#contact"
            class={`text-center font-semibold px-6 py-3 rounded-md transition-colors ${tier.highlight ? 'bg-accent hover:bg-accent-dark text-white' : 'border border-accent text-accent hover:bg-accent/5'}`}
          >
            Get a quote
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Implementation fee note -->
  <section class="py-8 px-6 border-t border-border">
    <div class="max-w-3xl mx-auto text-center">
      <h3 class="text-lg font-bold text-navy mb-2">One-time implementation fee</h3>
      <p class="text-ink/70 text-sm leading-relaxed">
        Covers deployment, data migration, staff training, and the validation documentation package (IQ/OQ/PQ).
        Typically <Evidence claim="implementation-fee" variant="inline" /> depending on site size. Quoted per engagement.
      </p>
      <p class="mt-4 text-xs text-muted-soft">
        Infrastructure included · Per-site licensing · Multi-site discounts available
      </p>
    </div>
  </section>

  <section class="bg-navy text-white py-16 px-6 text-center">
    <h2 class="text-2xl font-bold mb-4">Ready for a tailored quote?</h2>
    <a href="/about#contact" class="bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3 rounded-md transition-colors inline-block">
      Contact us
    </a>
  </section>
</BaseLayout>
