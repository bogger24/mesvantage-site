---
import BaseLayout from '../layouts/BaseLayout.astro';
import Evidence from '../components/Evidence.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import { claims } from '../data/claims';
---

<BaseLayout
  title="Platform — every module, across six domains"
  description="The full MESvantage platform: Quality, Production, Metrology, Training, Intelligence, and Platform domains. Built for medical device manufacturing."
>

  <!-- Hero -->
  <section class="bg-navy-deep text-white pt-20 pb-16 px-6 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.05] pointer-events-none grid-overlay"></div>
    <div class="max-w-6xl mx-auto relative">
      <p class="eyebrow text-accent-onDark tick-on-dark">The platform</p>
      <h1 class="mt-1 text-display-md md:text-display-lg text-white max-w-3xl text-balance">
        <Evidence onDark claim="module-count" variant="inline" /> modules. One platform.
      </h1>
      <p class="mt-6 text-lg text-white/70 max-w-2xl leading-relaxed">
        Six domains covering the full medical-device manufacturing lifecycle — from incoming
        inspection to executive intelligence.
      </p>
    </div>

    <!-- Domain quick-jump -->
    <div class="max-w-6xl mx-auto mt-10 grid grid-cols-3 md:grid-cols-6 gap-px bg-rule-onDeep border border-rule-onDeep relative">
      {[
        { id: 'quality', label: 'Quality' },
        { id: 'production', label: 'Production' },
        { id: 'metrology', label: 'Metrology' },
        { id: 'training', label: 'Training' },
        { id: 'intelligence', label: 'Intelligence' },
        { id: 'platform', label: 'Platform' },
      ].map(d => (
        <a
          href={`#${d.id}`}
          class="bg-navy-deep hover:bg-white/5/5 px-3 py-3 font-mono text-[11px] font-semibold uppercase tracking-eyebrow text-center text-muted-onDark hover:text-white transition-colors"
        >
          {d.label}
        </a>
      ))}
    </div>
  </section>

  <!-- ====================== QUALITY ====================== -->
  <section id="quality" class="py-24 px-6 bg-navy-lift border-b border-rule-onDark">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
        <div>
          <span class="eyebrow text-accent-onDark tick-on-dark">Domain 01 · Quality</span>
          <h2 class="mt-2 text-display-sm md:text-display-md text-white leading-tight">Quality, end to end. ISO 13485 by design.</h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            A complete quality management suite covering incoming goods, in-process inspection, FAI, SPC, NCR/CAPA workflows, and OEM-facing customer portals. Every record is electronically signed and version-locked under 21 CFR Part 11.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-sm content-start">
          {[
            'First Article Inspection (FAI)',
            'First Pass Yield (FPY) tracking',
            'Statistical Process Control (SPC)',
            'Device History Record (DHR)',
            'Incoming Inspection workflow',
            'Non-Conformance Reports (NCR)',
            'Corrective Action (CAPA)',
            'Customer Quality Portal',
            'Hold & quarantine management',
            'Quality KPI dashboards',
            'Out-of-tolerance alerting',
            'Root-cause analysis tooling',
          ].map(m => (
            <li class="flex items-start gap-2 text-white/80">
              <span class="text-accent-onDark font-bold mt-0.5">✓</span>{m}
            </li>
          ))}
        </ul>
      </div>

      <!-- Mockup: Quality dashboard with SPC chart -->
      <ProductScreenshot image="inspections-desktop.png" caption="Inspection queue — incoming, in-process and final, against the plan" tone="dark" />

    </div>
  </section>

  <!-- ====================== PRODUCTION ====================== -->
  <section id="production" class="py-24 px-6 bg-navy-lift border-b border-rule-onDark">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
        <div>
          <span class="eyebrow text-accent-onDark tick-on-dark">Domain 02 · Production</span>
          <h2 class="mt-2 text-display-sm md:text-display-md text-white leading-tight">Real-time floor intelligence. No manual entry.</h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            Live OEE direct from machine telemetry. Closed-loop scheduling that absorbs unplanned downtime in real time. In-process documentation that operators actually use because it's on the work order, not on the shared drive.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-sm content-start">
          {[
            'OEE — live per machine and fleet',
            'Production scheduling (closed-loop)',
            'In-Process Documentation (IPD)',
            'Standard Times & variance analysis',
            'Operator graduation & release',
            'Work order execution tracking',
            'Setup time tracking',
            'Downtime root-cause coding',
            'Shift handover briefings',
            'Throughput vs. takt time',
            'Cell load balancing',
            'Live escalation routing',
          ].map(m => (
            <li class="flex items-start gap-2 text-white/80">
              <span class="text-accent-onDark font-bold mt-0.5">✓</span>{m}
            </li>
          ))}
        </ul>
      </div>

      <!-- Mockup: Production schedule + OEE waterfall -->
      <ProductScreenshot image="ipd-executions-desktop.png" caption="In-process documentation — forced sequence, stage locking, and every result recorded against the plan" tone="dark" />

    </div>
  </section>

  <!-- ====================== METROLOGY ====================== -->
  <section id="metrology" class="py-24 px-6 bg-navy-lift border-b border-rule-onDark">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
        <div>
          <span class="eyebrow text-accent-onDark tick-on-dark">Domain 03 · Metrology</span>
          <h2 class="mt-2 text-display-sm md:text-display-md text-white leading-tight">CMM data, parsed automatically.</h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            AI-powered ingestion for Renishaw, Hexagon, and Zeiss output. The platform reads the report, extracts every feature, links it back to the part drawing tolerance, flags out-of-tolerance, and writes the result to the DHR — without an inspector touching a keyboard.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-sm content-start">
          {[
            'CMM result ingestion (auto)',
            'Renishaw / Hexagon / Zeiss support',
            'AI feature-to-tolerance mapping',
            'Calibration management',
            'Out-of-tolerance alerting',
            'GD&T attribute parsing',
            'Instrument type classification',
            'Operator-readable PDF reports',
            'Drift detection over lots',
            'Auto-link to part revision',
          ].map(m => (
            <li class="flex items-start gap-2 text-white/80">
              <span class="text-accent-onDark font-bold mt-0.5">✓</span>{m}
            </li>
          ))}
        </ul>
      </div>

      <!-- Mockup: CMM report parsed -->
      <ProductScreenshot image="spc-desktop.png" caption="Statistical process control — characteristic-level, with control limits" tone="dark" />

    </div>
  </section>

  <!-- ====================== TRAINING ====================== -->
  <section id="training" class="py-24 px-6 bg-navy-lift border-b border-rule-onDark">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
        <div>
          <span class="eyebrow text-accent-onDark tick-on-dark">Domain 04 · Training</span>
          <h2 class="mt-2 text-display-sm md:text-display-md text-white leading-tight">Training enforced at the point of work.</h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            Operators only see operations they're trained for. Trainer/trainee workflows are built into the work order, not bolted on as a checklist. Cert expiry triggers automatic graduation review.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-sm content-start">
          {[
            'Training enforcement at WO start',
            'Trainer/trainee context tracking',
            'Operator scope by part / op',
            'Qualio QMS bidirectional sync',
            'Cert expiry alerts',
            'Graduation workflow',
            'Training gap analytics',
            'Skills matrix by cell',
            'Re-training trigger rules',
            'Audit-ready training history',
          ].map(m => (
            <li class="flex items-start gap-2 text-white/80">
              <span class="text-accent-onDark font-bold mt-0.5">✓</span>{m}
            </li>
          ))}
        </ul>
      </div>

      <!-- Mockup: Skills matrix grid -->

    </div>
  </section>

  <!-- ====================== INTELLIGENCE ====================== -->
  <section id="intelligence" class="py-24 px-6 bg-navy-lift border-b border-rule-onDark">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
        <div>
          <span class="eyebrow text-accent-onDark tick-on-dark">Domain 05 · Intelligence</span>
          <h2 class="mt-2 text-display-sm md:text-display-md text-white leading-tight">From shop floor to CEO. One pane of glass.</h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            Live executive intelligence aggregated across operations, finance, supply chain, and quality. An assistant grounded in your own records: it answers using retrieval over your MESvantage data and links to the source record behind each statement. It cannot approve, sign, disposition or release anything.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-sm content-start">
          {[
            'CEO Intelligence Dashboard',
            'AI Executive Agent (LLM)',
            'Energy & sustainability intel',
            'Machine condition monitoring',
            'Customer-facing portals',
            'Power BI bidirectional',
            'Ops intelligence stream',
            'Continuous improvement tracker',
            'BD & pipeline intel',
            'Competitive intel feed',
            'Energy ECM live data',
            'Anomaly detection (auto)',
          ].map(m => (
            <li class="flex items-start gap-2 text-white/80">
              <span class="text-accent-onDark font-bold mt-0.5">✓</span>{m}
            </li>
          ))}
        </ul>
      </div>

      <!-- Mockup: CEO dashboard -->

    </div>
  </section>

  <!-- ====================== PLATFORM ====================== -->
  <section id="platform" class="py-24 px-6 bg-navy-lift">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
        <div>
          <span class="eyebrow text-accent-onDark tick-on-dark">Domain 06 · Platform</span>
          <h2 class="mt-2 text-display-sm md:text-display-md text-white leading-tight">Compliance-grade foundations.</h2>
          <p class="mt-4 text-muted-onDark leading-relaxed">
            Every record signed, hashed and audit-trailed. Every action role-gated. Every customer in
            their own isolated deployment. The platform is the object of validation — we supply the
            evidence that lets your team qualify it in your environment.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-sm content-start">
          {[
            'Mobile PWA (install-ready)',
            'Digital factory floor signage',
            'Audit trail against 21 CFR Part 11 §11.10',
            'Electronic signatures against Part 11 Subpart C',
            'Role-based access control',
            'Microsoft Entra SSO',
            'Dedicated deployment per customer',
            'Backups with tested restores — last test date published',
            'ERP integration (M1/SAP/Plex)',
            'Power BI bidirectional',
            'OneDrive document linking',
            'Infrastructure provisioned from code',
          ].map(m => (
            <li class="flex items-start gap-2 text-white/80">
              <span class="text-accent-onDark font-bold mt-0.5">✓</span>{m}
            </li>
          ))}
        </ul>
      </div>

      {/*
        REMOVED 2026-07-27: fabricated "Audit Trail · 21 CFR Part 11" mockup.
        It depicted a record-integrity control operating correctly — hash chain valid, named
        actors applying electronic signatures, invented block hashes, "3,482 events today" —
        using entirely invented data and carrying no disclaimer.
        Two reasons it cannot be labelled and kept:
          1. Customers paste vendor screenshots into their validation files. A fabricated Part 11
             audit-trail image entering a customer's validation package is falsified evidence
             with our logo on it.
          2. We hold an internal finding of open e-signature enforcement gaps. Publishing a
             picture of that control working is the "they knew" narrative, pre-assembled.
        Replacement: the Part 11 control map on /validation — control -> mechanism -> evidence
        artefact, including open items. Never a depicted audit trail.
      */}


      <div class="bg-navy-lift border border-rule-onDark rounded-md p-8 md:p-10">
        <h3 class="text-xl font-bold text-white">How we evidence Part 11, rather than illustrate it</h3>
        <p class="mt-3 text-muted-onDark leading-relaxed max-w-3xl">
          Audit trail and electronic signature controls are implemented against 21 CFR Part 11
          §11.10, §11.50 and §11.70. We publish the control map — each control, the mechanism that
          implements it, and the evidence artefact that demonstrates it — rather than a picture of
          a record. Our current control matrix, including open items, is available for review
          under NDA.
        </p>
        <a href="/compliance" class="inline-flex items-center gap-1 mt-5 min-h-[24px] text-sm font-semibold text-accent-onDark hover:text-white transition-colors">
          See the compliance detail
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-navy text-white py-20 px-6 text-center">
    <h2 class="text-3xl font-bold mb-4">Ready to see the full platform?</h2>
    <p class="text-white/70 mb-8 max-w-xl mx-auto">
      A 30-minute session walks through every domain. Bring us the hardest part you make and we will show you that part's life in MESvantage.
    </p>
    <a href="/about#contact" class="bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-md transition-colors inline-block">
      Book a Demo
    </a>
  </section>


  <section class="bg-navy-lift border-t border-rule-onDark">
    <div class="max-w-6xl mx-auto px-6 py-8">
      <p class="text-sm text-muted-onDark leading-relaxed">
        <span class="font-semibold text-white">About the interface images on this page.</span>
        They are screenshots of MESvantage running against a demonstration dataset — the real
        application, not illustrations of it. Ardara Orthopaedics is a fictional manufacturer and
        every record shown is seeded demonstration data, so no part, person or customer on this
        page is real. Each caption records the route, the build it was captured from, and the date.
      </p>
    </div>
  </section>

</BaseLayout>
