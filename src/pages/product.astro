---
import BaseLayout from '../layouts/BaseLayout.astro';

const domains = [
  {
    name: 'Quality',
    description:
      'Full quality management suite designed for ISO 13485 compliance. Covers the complete quality lifecycle from incoming goods to final release, with digital DHR and electronic signatures throughout.',
    modules: [
      'First Article Inspection (FAI)',
      'First Pass Yield (FPY) tracking',
      'Statistical Process Control (SPC)',
      'Device History Record (DHR)',
      'Incoming Inspection',
      'Customer Quality Portal',
      'Quality Dashboard',
    ],
  },
  {
    name: 'Production',
    description:
      'Real-time production floor intelligence. OEE is calculated live from machine data — no manual entry. Scheduling integrates with your ERP routing to give operators a single source of truth.',
    modules: [
      'Overall Equipment Effectiveness (OEE)',
      'Production Scheduling',
      'In-Process Documentation (IPD)',
      'Standard Times & Variance',
      'Graduation & Release',
    ],
  },
  {
    name: 'Metrology',
    description:
      'AI-powered CMM result parsing that eliminates manual data entry from dimensional inspection. Supports Renishaw, Hexagon, and Zeiss report formats out of the box.',
    modules: [
      'CMM result ingestion & parsing',
      'Dimensional conformance tracking',
      'Calibration management',
      'Out-of-tolerance alerting',
    ],
  },
  {
    name: 'Training',
    description:
      'Operator training is enforced at the point of work — not on a spreadsheet. The system checks training status before allowing access to any operation, and flags gaps in real time.',
    modules: [
      'Training enforcement by operation',
      'Trainer/trainee context tracking',
      'Operator scope management',
      'Training gap reporting',
    ],
  },
  {
    name: 'Intelligence',
    description:
      'Executive and operational intelligence layers that surface what matters without requiring manual analysis. The CEO module gives leadership a live operational picture; the AI agent answers natural-language queries against live manufacturing data.',
    modules: [
      'CEO Intelligence Dashboard',
      'AI Executive Agent (natural language)',
      'Energy Intelligence & sustainability',
      'Machine utilisation intelligence',
      'Operational intelligence feeds',
    ],
  },
  {
    name: 'Platform',
    description:
      'Enterprise-grade platform foundations that regulated manufacturers require. FDA 21 CFR Part 11 compliance is built into the platform layer — not bolted on as an afterthought.',
    modules: [
      'Mobile PWA (install-ready)',
      'Digital factory floor signage',
      'Full audit trail (21 CFR Part 11)',
      'Electronic signatures',
      'Role-based access control',
      'ERP integration (Infor M1, others)',
    ],
  },
];
---

<BaseLayout
  title="Product"
  description="MESvantage module breakdown — 50+ modules across Quality, Production, Metrology, Training, Intelligence, and Platform domains."
>
  <section class="py-16 px-6 border-b border-border">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl font-extrabold text-navy">The full platform</h1>
      <p class="mt-4 text-lg text-ink/70 max-w-2xl mx-auto">
        50+ modules built and validated inside a live orthopaedic CDMO. Every feature exists because a production floor needed it.
      </p>
    </div>
  </section>

  {domains.map(domain => (
    <section class="py-16 px-6 border-b border-border last:border-0">
      <div class="max-w-5xl mx-auto grid md:grid-cols-5 gap-10">
        <div class="md:col-span-2">
          <h2 class="text-2xl font-bold text-navy">{domain.name}</h2>
          <p class="mt-3 text-ink/70 leading-relaxed">{domain.description}</p>
        </div>
        <ul class="md:col-span-3 grid sm:grid-cols-2 gap-3 content-start">
          {domain.modules.map(mod => (
            <li class="flex items-start gap-2 text-sm text-ink/80">
              <span class="text-accent font-bold mt-0.5">✓</span>
              {mod}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="bg-navy text-white py-16 px-6 text-center">
    <h2 class="text-2xl font-bold mb-4">See it in action</h2>
    <a href="/about#contact" class="bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3 rounded-md transition-colors inline-block">
      Book a Demo
    </a>
  </section>
</BaseLayout>
